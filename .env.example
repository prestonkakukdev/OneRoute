# Required
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Optional
# ROUTER_DB_PATH=./router.db
# ROUTER_DEFAULT_MODE=balanced          # cheap | balanced | best
# ROUTER_PORT=8787
# ROUTER_API_KEY=                       # if set, the gateway requires "Authorization: Bearer <key>"
# ROUTER_ESCALATION_MODEL=google/gemini-3.8-flash
# ROUTER_JEV_MODEL=jev-latest
# ROUTER_EXPLORATION=off                # off | thompson

# Artificial Analysis data API (free tier, attribution required)
ARTIFICIAL_ANALYSIS_API_KEY=
