# Model Router configuration. Copy to .env (or run `npm run setup`, which does it for you).
# .env is git-ignored: never commit real keys.

# --- Required -----------------------------------------------------------------------------------
# OpenRouter: runs the chosen models. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Jev (TypeSafe System One): reads each request so the router can pick a model. https://typesafe.ai
TYPESAFE_API_KEY=

# --- Optional -----------------------------------------------------------------------------------
# Artificial Analysis data API (free tier). Only needed to rebuild the model database yourself with
# `mrouter ingest`; the repo ships a ready-made catalog (data/catalog.json).
# ARTIFICIAL_ANALYSIS_API_KEY=

# ROUTER_PORT=8787
# ROUTER_API_KEY=                       # if set, the gateway and app require "Authorization: Bearer <key>"
# ROUTER_DEFAULT_MODE=balanced          # cheap | balanced | best
# ROUTER_DB_PATH=./router.db            # your chats, feedback and learned corrections live here
# ROUTER_STORE_PROMPTS=true             # false = keep prompt text out of the routing log
# ROUTER_ESCALATION_MODEL=google/gemini-3.8-flash
# ROUTER_JEV_MODEL=jev-latest
# ROUTER_JEV_TIMEOUT_MS=6000
# ROUTER_EXPLORATION=off                # off | thompson
