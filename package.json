{
  "name": "model-router",
  "version": "0.1.0",
  "description": "Semantic LLM router: Jev classifies the task, a deterministic optimizer picks the best model + reasoning effort.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mrouter": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli/index.js serve"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "commander": "^15.0.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
