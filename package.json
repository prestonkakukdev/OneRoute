{
  "name": "model-router",
  "version": "0.1.0",
  "description": "Semantic LLM router: Jev classifies the task, a deterministic optimizer picks the best model + reasoning effort.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "mrouter": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.json && npm run web:build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli/index.js serve",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "icons": "node web/scripts/icons.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^13.4.4",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.8",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
